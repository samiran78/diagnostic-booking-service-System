spring.application.name=diagnostic-booking-service

spring.datasource.url=jdbc:postgresql://localhost:5432/booking_db
spring.datasource.username=YOUR_DB_USER
spring.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

app.jwt.secret=REPLACE_WITH_RANDOM_STRING_OF_32_PLUS_CHARACTERS
app.jwt.expiration-minutes=60

app.admin.email=admin@example.com
app.admin.password=CHOOSE_A_PASSWORD